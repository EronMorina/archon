# Public site URL — used by metadata, sitemap and canonical tags.
NEXT_PUBLIC_SITE_URL=https://archon.studio

# Calendly scheduling link rendered on /contact
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/archon-studio/intro-call

# Google Analytics 4 — only loaded after cookie consent is granted.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Server-only. Contact form delivery via Resend (resend.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=archonisolutions@gmail.com
CONTACT_FROM_EMAIL=website@archon.studio

# Optional. Read-only GitHub token, used only to raise the API rate limit that
# the portfolio's repository list is fetched under. Unauthenticated requests
# get 60 an hour per IP, which is plenty for a build that refreshes hourly —
# set this only if a shared host IP starts getting throttled.
GITHUB_TOKEN=
